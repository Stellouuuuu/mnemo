PORT=3000
HOST=127.0.0.1
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=mnemo:latest

# Mémoire : inmemory (défaut) | postgres
MEMORY_STORE=inmemory

# Requis uniquement si MEMORY_STORE=postgres
# DATABASE_URL=postgresql://USER:PASSWORD@localhost:5434/mnemo

# Durcissement prototype (optionnel, valeurs par défaut indiquées)
# OLLAMA_TIMEOUT_MS=60000
# OLLAMA_TEMPERATURE=0.4
# HEALTH_CHECK_TIMEOUT_MS=3000
# CHAT_MAX_MESSAGE_CHARS=8000
# CHAT_MAX_HISTORY_MESSAGES=40
# JSON_BODY_LIMIT=256kb

# Auth (Phase 1) — pas de JWT, pas de SESSION_SECRET
# Origine du frontend (localhost et 127.0.0.1 du même port sont équivalents)
# FRONTEND_ORIGIN=http://localhost:5173
# SESSION_TTL_MS=604800000
# SESSION_MAX_PER_USER=5
# COOKIE_SECURE=false
# AUTH_RATE_LIMIT_MAX=10
# AUTH_RATE_LIMIT_WINDOW_MS=900000
# CHAT_RATE_LIMIT_MAX=30
# CHAT_RATE_LIMIT_WINDOW_MS=900000
# Derrière nginx / un reverse proxy :
# TRUST_PROXY=true
