{
  "name": "backend",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "test": "tsx --test tests/**/*.test.ts",
    "test:unit": "tsx --test tests/**/*.test.ts",
    "test:postgres": "STELLA_REQUIRE_POSTGRES=1 tsx --test tests/postgres-conversation-store.test.ts tests/postgres-memory-store.test.ts tests/postgres-auth.test.ts tests/postgres-conversation-engine.test.ts",
    "dev": "tsx watch src/server.ts",
    "build": "tsc && npm run build:copy-migrations",
    "build:copy-migrations": "mkdir -p dist/db/migrations && cp -f src/db/migrations/*.sql dist/db/migrations/",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "db:migrate": "tsx src/db/migrate.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.2",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.2.0",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  }
}
